% Why: one place for the deck colors on top of Moloch: dark text, grey for context, one accent for emphasis (Knaflic). Change the HTML values to restyle.
\ProvidesPackage{beamercolorthemeurutau}
\mode<presentation>
\definecolor{urutauDark}{HTML}{22313F}
\definecolor{urutauLight}{HTML}{FAFAFA}
\definecolor{urutauGrey}{HTML}{8A8F98}
\definecolor{urutauAccent}{HTML}{C2410C}
\setbeamercolor{normal text}{fg=urutauDark, bg=urutauLight}
\setbeamercolor{structure}{fg=urutauDark}
\setbeamercolor{alerted text}{fg=urutauAccent}
\setbeamercolor{example text}{fg=urutauGrey}
\setbeamercolor{palette primary}{fg=urutauLight, bg=urutauDark}
\setbeamercolor{frametitle}{fg=urutauLight, bg=urutauDark}
\setbeamercolor{progress bar}{fg=urutauAccent, bg=urutauGrey!40}
\setbeamercolor{title separator}{fg=urutauAccent, bg=urutauGrey!40}
\setbeamercolor{progress bar in head/foot}{fg=urutauAccent, bg=urutauGrey!40}
\setbeamercolor{progress bar in section page}{fg=urutauAccent, bg=urutauGrey!40}
\mode<all>
